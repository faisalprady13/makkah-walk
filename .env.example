# Optional public MapLibre style JSON URL. Defaults to OpenStreetMap raster tiles.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional vector tile URL template for 3D building extrusions.
# Vector tile styles commonly use a {z}/{x}/{y} URL template.
NEXT_PUBLIC_BUILDING_TILE_URL=
NEXT_PUBLIC_BUILDING_SOURCE_LAYER=building

# These stay on the local demonstration providers in this MVP.
# Replace the infrastructure provider registry when a real provider is implemented.
NEXT_PUBLIC_GEOCODING_PROVIDER=mock
NEXT_PUBLIC_ROUTING_PROVIDER=mock
