# Optional public MapLibre style JSON URL. Defaults to OpenStreetMap raster tiles.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional vector tile URL template for 3D building extrusions.
# Vector tile styles commonly use a {z}/{x}/{y} URL template.
NEXT_PUBLIC_BUILDING_TILE_URL=
NEXT_PUBLIC_BUILDING_SOURCE_LAYER=building

# Geocoding currently uses the local Makkah demonstration dataset.
NEXT_PUBLIC_GEOCODING_PROVIDER=mock

# Routing defaults to demonstration data and requires no API key.
ROUTING_PROVIDER=mock

# To enable accurate-network pedestrian routing, set ROUTING_PROVIDER=openrouteservice
# and provide a private server-side key. Never add NEXT_PUBLIC_ to this variable.
# OPENROUTESERVICE_API_KEY=your_api_key
